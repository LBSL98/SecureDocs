APP_ENV=development
APP_SECRET_KEY=replace-with-local-random-secret
DOCUMENT_CRYPTO_KEY=replace-with-fernet-key-generated-by-script
DATABASE_URL=sqlite:///./securedocs.db
PRIVATE_STORAGE_DIR=private_storage
